<?xml version="1.0" encoding="UTF-8"?>
<!-- Written for zusbml (MIT): a drug absorbed from the gut into the
     central compartment and eliminated, with a second dose at time 12. -->
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model id="dosing" name="Oral dosing with a second dose" timeUnits="hour">
    <listOfCompartments>
      <compartment id="gut" spatialDimensions="3" size="1" constant="true"/>
      <compartment id="central" spatialDimensions="3" size="10" constant="true"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="drug_gut" compartment="gut" initialAmount="100" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false"/>
      <species id="drug" compartment="central" initialAmount="0" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="ka" value="1" constant="true"/>
      <parameter id="ke" value="0.2" constant="true"/>
      <parameter id="dose" value="100" constant="true"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="absorption" reversible="false">
        <listOfReactants>
          <speciesReference species="drug_gut" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="drug" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><times/><ci>ka</ci><ci>drug_gut</ci></apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="elimination" reversible="false">
        <listOfReactants>
          <speciesReference species="drug" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply><times/><ci>ke</ci><ci>drug</ci><ci>central</ci></apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
    <listOfEvents>
      <event id="second_dose" useValuesFromTriggerTime="true">
        <trigger initialValue="false" persistent="true">
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <geq/>
              <csymbol encoding="text" definitionURL="http://www.sbml.org/sbml/symbols/time">t</csymbol>
              <cn>12</cn>
            </apply>
          </math>
        </trigger>
        <listOfEventAssignments>
          <eventAssignment variable="drug_gut">
            <math xmlns="http://www.w3.org/1998/Math/MathML">
              <apply><plus/><ci>drug_gut</ci><ci>dose</ci></apply>
            </math>
          </eventAssignment>
        </listOfEventAssignments>
      </event>
    </listOfEvents>
  </model>
</sbml>
